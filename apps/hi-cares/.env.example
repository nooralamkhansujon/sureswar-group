# EmailJS (emailjs.com) — used by the contact form to send inquiries without a backend.
NEXT_PUBLIC_HICARE_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_HICARE_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_HICARE_EMAILJS_PUBLIC_KEY=

# Destination address for contact form inquiries.
# Must match the "To email" field configured on the EmailJS template.
NEXT_PUBLIC_HICARE_CONTACT_EMAIL=
