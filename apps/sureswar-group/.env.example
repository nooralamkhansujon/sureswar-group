# EmailJS (emailjs.com) — used by the inquiry form to send messages without a backend.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Destination address for inquiry form submissions.
# Must match the "To email" field configured on the EmailJS template.
NEXT_PUBLIC_CONTACT_EMAIL=
